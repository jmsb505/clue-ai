# Copy this file to .env. Keep this value empty until you are ready to configure Jev.
TYPESAFE_API_KEY=

# The initial Jev release is pinned so rubric changes are deliberate.
TYPESAFE_MODEL=jev-1.13.0

# Local data stays under this ignored directory unless you choose another path.
CLUE_DATA_DIR=.data

# App-side Jev inference budget leaves a $1 buffer inside the $5 rolling 30-day ceiling.
JEV_MONTHLY_BUDGET_USD=4.00

# Add an OpenAI key only after development is complete and you are ready to enable API use.
OPENAI_API_KEY=

# Optional Gmail Drafts integration. Use a Google OAuth Desktop client.
# Add http://127.0.0.1:8765/ as the loopback redirect URI in Google Cloud.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
